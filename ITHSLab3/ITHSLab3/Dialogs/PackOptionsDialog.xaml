<Window x:Class="ITHSLab3.Views.PackOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ITHSLab3.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Question Pack Settings"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Padding="16"
        Background="{StaticResource QuizBg}">

    <Window.Resources>
        <!-- All enum values for Difficulty -->
        <ObjectDataProvider x:Key="DifficultyValues"
                            ObjectType="{x:Type sys:Enum}"
                            MethodName="GetValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:Difficulty" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <!-- Outer panel to match main theme -->
    <Border Background="{StaticResource QuizPanelBg}"
            CornerRadius="8"
            Padding="16">

        <Grid Margin="4">
            <Grid.RowDefinitions>
                <!-- Difficulty -->
                <RowDefinition Height="Auto"/>
                <!-- Time -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Difficulty -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Difficulty"
                       Margin="0,0,8,8"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="White" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding Source={StaticResource DifficultyValues}}"
                      SelectedItem="{Binding Difficulty, Mode=TwoWay}"
                      Background="#222222"
                      Foreground="White"
                      BorderBrush="#555555" />

            <!-- Time limit text box -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Time Limit (sec)"
                       Margin="0,0,8,8"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="White" />

            <StackPanel Grid.Row="1" Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBox x:Name="TimeLimitTextBox"
                         Width="60"
                         Text="{Binding TimePerQuestion, Mode=OneWay}"
                         HorizontalContentAlignment="Right"
                         Margin="0,0,8,0"
                         Background="White"
                         Foreground="White"
                         BorderBrush="#555555" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="LightGray"
                           Text="(3–120 sec, invalid → 60)" />
            </StackPanel>

            <!-- OK / Cancel -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="OK"
                        Width="75"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="OkButton_Click" />
                <Button Content="Cancel"
                        Width="75"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
